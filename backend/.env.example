# Example environment variables for geopasto backend
# Copy this file to backend/.env and fill the values

DJANGO_SECRET_KEY=replace-me-with-a-secure-key
DEBUG=False

# Format: postgis://USER:PASSWORD@HOST:PORT/NAME  (postgis:// requis pour GeoDjango)
#DATABASE_URL=postgis://user:password@127.0.0.1:5432/geopasto

# Hôtes autorisés (CSV) — défaut "*" si absent
#ALLOWED_HOSTS=localhost,127.0.0.1

# Chemin absolu vers le répertoire des fichiers statiques collectés
#STATIC_ROOT=/path/to/your/static/

# Origines autorisées pour CORS (CSV)
#CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Origines de confiance pour CSRF (CSV, HTTPS requis en prod)
#CSRF_TRUSTED_ORIGINS=https://votredomaine.fr
