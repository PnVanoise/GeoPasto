# URL de base de l'API Django.
#
# Option A — dev local sans nginx (browser → Vite direct sur localhost:5173)
#   Laisser vide : Vite proxy les appels /api/, /admin/, /choices_logement/ vers localhost:8000
# VITE_API_BASE_URL=
#
# Option B — serveur avec nginx en frontal (production, ou dev sur serveur distant)
#   Pointer vers le domaine public : nginx proxy /api/, /admin/, /choices_logement/ vers Django
# VITE_API_BASE_URL=http://pastoralisme.vanoise-parcnational.fr
VITE_API_BASE_URL=
